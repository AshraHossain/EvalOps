EVALOPS_APP_NAME=EvalOps API
EVALOPS_ENVIRONMENT=dev
EVALOPS_API_PREFIX=/api/v1

EVALOPS_POSTGRES_DSN=postgresql+asyncpg://evalops:evalops@localhost:5432/evalops
EVALOPS_ALEMBIC_DSN=postgresql+psycopg2://evalops:evalops@localhost:5432/evalops
EVALOPS_REDIS_URL=redis://localhost:6379/0

